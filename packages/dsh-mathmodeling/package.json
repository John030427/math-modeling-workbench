{
  "name": "@math-modeling/dsh-mathmodeling",
  "version": "0.2.0",
  "description": "DSH 数模工作台插件：Model Atlas、K-Means 课程、Quiz、mastery、modeling-tutor",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "assets",
    "skills",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-skill": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-skill": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-registry.mjs",
    "build": "node scripts/generate-registry.mjs && npm run build:deps && node scripts/build-client.mjs",
    "build:deps": "npm --prefix ../core run build && npm --prefix ../ui run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
